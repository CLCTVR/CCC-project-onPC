rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- PROFILES COLLECTION  ---
    match /profiles/{profileId} {
      // Admin has full access
      allow read, write: if request.auth != null && request.auth.token.email == 'clctvr@gmail.com';
      
      function isOwner() {
        return request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == profileId);
      }

      // ✅ CONSOLIDATED: Any authenticated user can READ profiles (for averaging)
      // Owner can also UPDATE/DELETE their own
      allow read: if request.auth != null;
      allow update, delete: if isOwner();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // --- VENUES SECTION ---
    match /venues/{venueId} {
      allow read: if true;  // ✅ Public read access
      allow create: if request.auth != null;
      
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitCount'])
                    && request.resource.data.visitCount is number;
      
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rankedScores', 'profileCode']);
      
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitCount', 'rankedScores', 'profileCode']);
      
      allow update, delete: if request.auth != null && (request.auth.token.email == 'clctvr@gmail.com' || request.auth.uid == resource.data.userId);
    }
    
    // --- VISITS SECTION ---
    match /visits/{visitId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    
    // --- OTHER ---
    match /publicStars/{starId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
    
    // --- CHEKTUS SESSIONS ---
    match /CT_Sessions/{sessionId} {
      // Admin has full access
      allow read, write: if request.auth != null && request.auth.token.email == 'clctvr@gmail.com';
      
      // Users can create, read, and update (to join)
      allow read, create, update: if request.auth != null;
    }
  }
}